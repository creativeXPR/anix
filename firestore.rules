rules_version = '2';

// See CLAUDE.md #008/#009 for the full design record.
//
// rooms/{roomId} and messageEndpoints/{endpointId}: up to 3 each per
// account, roomId/endpointId is the user-chosen handle (not a random id
// or the uid — that was the previous, now-superseded model). The
// handle-uniqueness and 3-per-account cap are enforced by the
// `createRoom`/`createMessageEndpoint` Cloud Functions (a transaction
// can check "does this handle exist" + "how many do I already own"
// atomically; security rules alone can't count existing docs). Rules
// here just gate ownership for update/delete/list once a doc exists.
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Admin (2026-09-19) ----
    //
    // Mirrors Anime-space's admin/gate + adminUnlocks pattern exactly
    // (see that project's firestore.rules for the original writeup):
    // "logging into" /admin (AdminApp.jsx) is nothing but this write
    // succeeding — the client submits the typed passcode as an
    // adminUnlocks/{uid} doc's own `passcode` field, and the rule
    // rejects the write outright unless it equals admin/gate's real
    // value. The real passcode is never shipped in the JS bundle to
    // check it there, and a later visit with the same uid (anonymous
    // auth persists per-browser) finds the unlock doc already exists
    // and skips the prompt. admin/gate itself is never directly
    // readable/writable by any client — seeded once via the Admin SDK.
    function isUnlockedAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/adminUnlocks/$(request.auth.uid));
    }

    // Unique-visitor counting (shared/visits.js): one create-only doc per
    // browser per UTC day, id `{day}_{random visitor id}`; only /admin
    // reads (counts) them.
    match /visits/{visitId} {
      allow create: if request.resource.data.keys().hasOnly(['day', 'createdAt'])
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && visitId.matches('^' + request.resource.data.day + '_[0-9a-f]{24}$')
        && request.resource.data.createdAt == request.time;
      allow read: if isUnlockedAdmin();
      allow update, delete: if false;
    }

    // Room stickers (2026-10-14): built in `{pack, id}`, or an upload
    // `{url}` that must live in this project's own Storage (no outside
    // images / tracking pixels).
    function validSticker(s) {
      return s is map && s.size() <= 2
        && ((s.keys().hasOnly(['url']) && s.url is string && s.url.size() < 600
              && s.url.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/c-xpr25[.]firebasestorage[.]app/o/anix%2Fstickers%2F.*'))
          || (s.keys().hasOnly(['pack', 'id']) && s.pack is string && s.pack.size() <= 20 && s.id is string && s.id.size() <= 30));
    }

    // ---- Security hardening (2026-10-14 audit) ----
    // Images anyone else's browser will load must come from this project's
    // own Storage, under the given folder — an outside URL would let its
    // host log the IP address of everyone viewing the room / link page
    // (de-anonymising them) or swap in anything later.
    function ownStorageUrl(url, folder) {
      return url is string && url.size() < 600
        && url.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/c-xpr25[.]firebasestorage[.]app/o/' + folder + '.*');
    }

    function optionalOwnImage(data, field, folder) {
      return !(field in data) || data[field] == null || ownStorageUrl(data[field], folder);
    }

    // Owner privacy: public docs carry ownerHash = base64(sha256(uid:docId))
    // instead of the uid (see functions/index.js ownerHash) — the same
    // person's rooms, link and private chats can't be matched up.
    function ownerHashOf(id) {
      return hashing.sha256(request.auth.uid + ':' + id).toBase64();
    }

    function ownsDoc(data, id) {
      return request.auth != null && data.get('ownerHash', '') == ownerHashOf(id);
    }

    // A room guest's id = hash(login uid : roomId : 'guest') — the
    // anonymous session (or real account) behind it is verified here, so
    // nobody posts/votes/types as someone else. ':guest' keeps it different
    // from the room's ownerHash.
    function guestIdOf(roomId) {
      return hashing.sha256(request.auth.uid + ':' + roomId + ':guest').toBase64();
    }

    function roomIsOpen(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.get('status', 'open') != 'closed';
    }

    // A plain room message: only the fields the app writes, sane sizes,
    // server time, images only from this room's own uploads.
    function validRoomMessage(roomId, data) {
      return data.keys().hasOnly(['text', 'senderId', 'imageUrl', 'replyTo', 'badge', 'sticker', 'createdAt'])
        && data.text is string && data.text.size() <= 2000
        && request.auth != null && data.senderId == guestIdOf(roomId)
        && optionalOwnImage(data, 'imageUrl', 'anix%2Frooms%2F' + roomId + '%2Fimages%2F')
        && (!('replyTo' in data) || data.replyTo == null
          || (data.replyTo is map && data.replyTo.keys().hasOnly(['id', 'text', 'senderId', 'imageUrl'])
            && (!('text' in data.replyTo) || data.replyTo.text == null || (data.replyTo.text is string && data.replyTo.text.size() <= 2000))
            && (!('imageUrl' in data.replyTo) || data.replyTo.imageUrl == null
              || ownStorageUrl(data.replyTo.imageUrl, 'anix%2Frooms%2F' + roomId + '%2Fimages%2F')
              || ownStorageUrl(data.replyTo.imageUrl, 'anix%2Fstickers%2F'))))
        && (!('badge' in data) || data.badge == null || (data.badge is map && data.badge.size() <= 4))
        && (!('sticker' in data) || data.sticker == null || validSticker(data.sticker))
        && data.createdAt == request.time;
    }

    function pollOption(options, i) {
      return options[i] is string && options[i].size() > 0 && options[i].size() <= 40;
    }

    function validPoll(data) {
      return data.keys().hasOnly(['type', 'text', 'options', 'createdAt'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 120
        && data.options is list && data.options.size() >= 2 && data.options.size() <= 4
        && pollOption(data.options, 0) && pollOption(data.options, 1)
        && (data.options.size() < 3 || pollOption(data.options, 2))
        && (data.options.size() < 4 || pollOption(data.options, 3))
        && data.createdAt == request.time;
    }

    // Live match data for football rooms' match card — written only by
    // the footballSync Cloud Function (Admin SDK); everyone reads.
    match /footballMatches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    // Football fan badges: built-in list in code + these, managed from
    // /admin → Badges. Everyone reads; only the unlocked admin writes.
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isUnlockedAdmin();
    }

    // "Can't find my club/country" — anyone can ask (shape checked); only
    // /admin reads and clears them.
    match /badgeRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'kind', 'type', 'where', 'details', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.kind in ['club', 'country', 'series', 'vibe']
        && request.resource.data.get('type', 'football') in ['football', 'anime', 'weird']
        && request.resource.data.where is string && request.resource.data.where.size() <= 60
        && request.resource.data.details is string && request.resource.data.details.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isUnlockedAdmin();
      allow update: if false;
    }

    match /admin/gate {
      allow read, write: if false;
    }

    // Unlocking goes through the unlockAdmin function (server-side check,
    // max 5 wrong tries / 15 min per IP and per account) — clients can
    // only check whether they're already unlocked.
    match /adminUnlocks/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /adminAttempts/{key} {
      allow read, write: if false;
    }

    // Admin switches (e.g. room moderation on/off) — the unlocked admin
    // reads and flips them; functions read them with the Admin SDK.
    match /config/{name} {
      allow read, write: if isUnlockedAdmin();
    }

    // Collection-group match so a single query lists every room's
    // reports at once without the admin dashboard needing to already
    // know every roomId — additive with the more specific rule inside
    // match /rooms/{roomId} below (Firestore rules OR across every
    // rule whose path matches a given request).
    match /{path=**}/reports/{reportId} {
      allow list, get: if isUnlockedAdmin();
    }

    // Moderation queue (2026-10-12): the admin dashboard lists filtered /
    // unchecked messages across every link and private conversation with
    // one collection-group query, and can delete them.
    match /{path=**}/messages/{messageId} {
      allow list, get, delete: if isUnlockedAdmin();
    }

    match /rooms/{roomId} {
      allow get: if true;
      // No listing: your own rooms come from owners/{uid} (private).
      allow list: if false;
      // Creation goes through the createRoom Cloud Function (Admin SDK,
      // bypasses these rules) for the handle-uniqueness/3-cap checks —
      // no direct client create.
      allow create: if false;
      // Owner: room settings only (never ownerId/handle — those are set by
      // the createRoom function), and the photo must be our own upload.
      allow update: if (ownsDoc(resource.data, roomId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['emoji', 'bannerImageUrl', 'themeColor', 'status', 'type', 'pinnedMatch', 'stickerPack', 'lastActivityAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bannerImageUrl'])
            || optionalOwnImage(request.resource.data, 'bannerImageUrl', 'anix%2Frooms%2F' + roomId + '%2Fbanner%2F')))
        // anyone sending a message bumps lastActivityAt — but only to
        // "now" (a past date would get the room auto-deleted, a future one
        // would keep it alive forever)
        || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt'])
          && request.resource.data.lastActivityAt == request.time)
        // the admin dashboard may close a reported room
        || (isUnlockedAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'closed');
      // No client-side delete — goes through the deleteRoom Cloud
      // Function so subcollections/Storage banner get cleaned up too.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        // Ordinary messages (optionally carrying the sender's fan-badge
        // snapshot), or a poll: `type: 'poll'`, question as `text`, 2–4
        // `options`, and NO senderId — polls are never attributed
        // (2026-10-13, football rooms).
        // Only while the room is open (a closed room is read-only).
        allow create: if roomIsOpen(roomId)
          && ((!('type' in request.resource.data) && validRoomMessage(roomId, request.resource.data))
            || (request.auth != null && request.resource.data.get('type', null) == 'poll' && validPoll(request.resource.data)));
        // No edit/delete — messages are anonymous and immutable (#002).
        allow update, delete: if false;

        // One vote per anonymous guest (doc id = their per-room id),
        // changeable; only on polls, only a real option index.
        match /votes/{voterId} {
          allow read: if true;
          allow create, update: if roomIsOpen(roomId)
            && request.auth != null && voterId == guestIdOf(roomId)
            && request.resource.data.keys().hasOnly(['option', 'updatedAt'])
            && request.resource.data.option is int
            && request.resource.data.option >= 0
            && request.resource.data.option < get(/databases/$(database)/documents/rooms/$(roomId)/messages/$(messageId)).data.options.size()
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }
      }

      match /typing/{participantId} {
        allow read: if true;
        allow delete: if request.auth != null && participantId == guestIdOf(roomId);
        allow create, update: if request.auth != null && participantId == guestIdOf(roomId)
          && request.resource.data.keys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }

      match /presence/{participantId} {
        allow read: if true;
        allow delete: if request.auth != null && participantId == guestIdOf(roomId);
        allow create, update: if request.auth != null && participantId == guestIdOf(roomId)
          && request.resource.data.keys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }

      match /reports/{reportId} {
        allow create: if request.resource.data.keys().hasOnly(['messageId', 'text', 'senderId', 'reporterId', 'stickerUrl', 'createdAt'])
          && request.resource.data.messageId is string && request.resource.data.messageId.size() <= 60
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && (request.resource.data.senderId == null || (request.resource.data.senderId is string && request.resource.data.senderId.size() <= 64))
          && request.auth != null && request.resource.data.reporterId == guestIdOf(roomId)
          && (!('stickerUrl' in request.resource.data) || request.resource.data.stickerUrl == null
            || ownStorageUrl(request.resource.data.stickerUrl, 'anix%2Fstickers%2F'))
          && request.resource.data.createdAt == request.time;
        // Only readable via the Admin SDK (a future moderation tool),
        // never by clients.
        allow read, update, delete: if false;
      }
    }

    match /messageEndpoints/{endpointId} {
      function isEndpointOwner() {
        return ownsDoc(get(/databases/$(database)/documents/messageEndpoints/$(endpointId)).data, endpointId);
      }

      allow get: if true;
      // No listing: your own links come from owners/{uid} (private).
      allow list: if false;
      allow create: if false;
      // Owner edits settings (photo, vibe, and since the NGL redesign the
      // prompt game: `game` + resolved `prompt` text, capped at 80 chars).
      // The admin dashboard may only extend the block list ("Block sender").
      allow update: if isUnlockedAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked']);
      allow update: if ownsDoc(resource.data, endpointId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bannerImageUrl', 'themeColor', 'game', 'prompt', 'blocked'])
        // senders load this photo on the link page — it must be our own
        // upload, not an outside URL that could log their IP addresses
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bannerImageUrl'])
          || optionalOwnImage(request.resource.data, 'bannerImageUrl', 'anix%2Fendpoints%2F' + endpointId + '%2Fbanner%2F'))
        && (!('prompt' in request.resource.data)
          || request.resource.data.prompt == null
          || (request.resource.data.prompt is string && request.resource.data.prompt.size() <= 80));
      allow delete: if false;

      // Anonymous senders write with no auth at all (that's the
      // feature); only the endpoint's owner can ever read messages back.
      match /messages/{messageId} {
        // Created only by the sendAnonymousMessage Cloud Function (Admin
        // SDK), which moderates the text first and enforces blocks — never
        // directly by clients (2026-10-12).
        allow create: if false;
        allow read: if isEndpointOwner();
        // NGL redesign (2026-10-12): the owner opens sealed messages
        // (`read`) and answers them (`answer`/`answeredAt`) — those three
        // fields only; the message text/game/prompt stay immutable.
        allow update: if isEndpointOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'answer', 'answeredAt'])
          && (!('read' in request.resource.data) || request.resource.data.read is bool)
          && (!('answer' in request.resource.data)
            || request.resource.data.answer == null
            || (request.resource.data.answer is string && request.resource.data.answer.size() <= 500))
          && (!('answeredAt' in request.resource.data)
            || request.resource.data.answeredAt == null
            || request.resource.data.answeredAt == request.time);
        // The owner can delete a message they received (behind a confirm).
        allow delete: if isEndpointOwner();
      }

      // The link owner reports a received message (Report in the inbox).
      match /reports/{reportId} {
        allow create: if isEndpointOwner()
          && request.resource.data.keys().hasOnly(['kind', 'messageId', 'text', 'reason', 'createdAt'])
          && request.resource.data.kind == 'message'
          && request.resource.data.reason in ['harassment', 'hate', 'threat', 'sexual', 'self-harm', 'spam', 'other']
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow read, update, delete: if false;
      }
    }

    // ---- Anonymous two-way reply (phase 2, 2026-10-12) ----
    //
    // threads/{threadId}: the id is a long random capability the SENDER's
    // browser generated and stamped on their message; knowing it is what
    // lets the sender read/post (no sender account exists). Only the link
    // owner can create the thread, and only at the id on that message.
    match /threads/{threadId} {

      allow get: if true;
      // No listing: the link owner keeps their thread ids in users/{uid}.
      allow list: if false;
      allow create: if request.auth != null
        && !('ownerId' in request.resource.data)
        && request.resource.data.ownerHash == ownerHashOf(threadId)
        && ownsDoc(get(/databases/$(database)/documents/messageEndpoints/$(request.resource.data.endpointId)).data, request.resource.data.endpointId)
        && get(/databases/$(database)/documents/messageEndpoints/$(request.resource.data.endpointId)/messages/$(request.resource.data.messageId)).data.threadId == threadId
        && request.resource.data.status == 'open';
      // Messages + their bookkeeping are written by the sendThreadMessage
      // Cloud Function (moderated). Clients only: the owner ends the thread
      // or marks their side seen; the sender marks their side seen.
      allow update: if (ownsDoc(resource.data, threadId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'ownerUnread', 'lastActivityAt', 'receipts'])
          && request.resource.data.status in ['open', 'ended']
          && request.resource.data.get('receipts', false) is bool)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senderUnread'])
          && request.resource.data.senderUnread == false);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        // Only via the sendThreadMessage Cloud Function (moderated).
        allow create, update, delete: if false;
      }

      // Either side reports the conversation / a message in it.
      match /reports/{reportId} {
        allow create: if request.resource.data.keys().hasOnly(['kind', 'messageId', 'text', 'reason', 'by', 'createdAt'])
          && request.resource.data.kind == 'thread'
          && request.resource.data.by in ['owner', 'sender']
          && request.resource.data.reason in ['harassment', 'hate', 'threat', 'sexual', 'self-harm', 'spam', 'other']
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow read, update, delete: if false;
      }
    }

    // Sender's "notify me when they reply" push token — write-only for
    // clients (anyone holding the thread id); only Cloud Functions read it.
    match /threadPush/{threadId} {
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 500;
      allow read, delete: if false;
    }

    // #006 push notifications (2026-09-21): fcmTokens lives here, owner-
    // only — a real account is required to receive a push at all (an
    // anonymous room/endpoint visitor has no account/token to attach
    // one to), so pushes only ever reach a room/endpoint's *owner*.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // "My stickers" — only the account itself.
      match /stickers/{stickerId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Your own rooms/links (ids) — written only by the create/delete
    // functions; readable only by you. The uid ↔ doc mapping itself
    // (ownership/*) is functions-only.
    match /owners/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /ownership/{docId} {
      allow read, write: if false;
    }

    // /welcome/contact form — anyone can send (no account needed), shape
    // validated; only the admin dashboard can read it.
    match /contact/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['topic', 'email', 'message', 'createdAt'])
        && request.resource.data.topic in ['question', 'idea', 'bug', 'safety report', 'business', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && (request.resource.data.email == null
          || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
        && request.resource.data.createdAt == request.time;
      allow list, get: if isUnlockedAdmin();
      allow update, delete: if false;
    }

    // Create-only from any signed-in user; read via the admin dashboard
    // (isUnlockedAdmin) or the Firebase console, never by a regular
    // client.
    match /feedback/{feedbackId} {
      // a real account (not the /admin page's anonymous session), as itself
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['userId', 'text', 'kind', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && (request.resource.data.kind == null || request.resource.data.kind in ['bug', 'idea', 'love'])
        && request.resource.data.createdAt == request.time;
      allow list, get: if isUnlockedAdmin();
      allow update, delete: if false;
    }
  }
}
