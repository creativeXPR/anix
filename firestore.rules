rules_version = '2';

// See CLAUDE.md #008/#009 for the full design record.
//
// rooms/{roomId} and messageEndpoints/{endpointId}: up to 3 each per
// account, roomId/endpointId is the user-chosen handle (not a random id
// or the uid — that was the previous, now-superseded model). The
// handle-uniqueness and 3-per-account cap are enforced by the
// `createRoom`/`createMessageEndpoint` Cloud Functions (a transaction
// can check "does this handle exist" + "how many do I already own"
// atomically; security rules alone can't count existing docs). Rules
// here just gate ownership for update/delete/list once a doc exists.
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Admin (2026-09-19) ----
    //
    // Mirrors Anime-space's admin/gate + adminUnlocks pattern exactly
    // (see that project's firestore.rules for the original writeup):
    // "logging into" /admin (AdminApp.jsx) is nothing but this write
    // succeeding — the client submits the typed passcode as an
    // adminUnlocks/{uid} doc's own `passcode` field, and the rule
    // rejects the write outright unless it equals admin/gate's real
    // value. The real passcode is never shipped in the JS bundle to
    // check it there, and a later visit with the same uid (anonymous
    // auth persists per-browser) finds the unlock doc already exists
    // and skips the prompt. admin/gate itself is never directly
    // readable/writable by any client — seeded once via the Admin SDK.
    function isUnlockedAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/adminUnlocks/$(request.auth.uid));
    }

    match /admin/gate {
      allow read, write: if false;
    }

    match /adminUnlocks/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.passcode == get(/databases/$(database)/documents/admin/gate).data.passcode;
      allow delete: if false;
    }

    // Collection-group match so a single query lists every room's
    // reports at once without the admin dashboard needing to already
    // know every roomId — additive with the more specific rule inside
    // match /rooms/{roomId} below (Firestore rules OR across every
    // rule whose path matches a given request).
    match /{path=**}/reports/{reportId} {
      allow list, get: if isUnlockedAdmin();
    }

    match /rooms/{roomId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;
      // Creation goes through the createRoom Cloud Function (Admin SDK,
      // bypasses these rules) for the handle-uniqueness/3-cap checks —
      // no direct client create.
      allow create: if false;
      allow update: if (request.auth != null && resource.data.ownerId == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt']);
      // No client-side delete — goes through the deleteRoom Cloud
      // Function so subcollections/Storage banner get cleaned up too.
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        // No edit/delete — messages are anonymous and immutable (#002).
        allow update, delete: if false;
      }

      match /typing/{participantId} {
        allow read, write: if true;
      }

      match /presence/{participantId} {
        allow read, write: if true;
      }

      match /reports/{reportId} {
        allow create: if true;
        // Only readable via the Admin SDK (a future moderation tool),
        // never by clients.
        allow read, update, delete: if false;
      }
    }

    match /messageEndpoints/{endpointId} {
      function isEndpointOwner() {
        return request.auth != null
          && get(/databases/$(database)/documents/messageEndpoints/$(endpointId)).data.ownerId == request.auth.uid;
      }

      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if false;
      // Owner edits settings (photo, vibe, and since the NGL redesign the
      // prompt game: `game` + resolved `prompt` text, capped at 80 chars).
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && (!('prompt' in request.resource.data)
          || request.resource.data.prompt == null
          || (request.resource.data.prompt is string && request.resource.data.prompt.size() <= 80));
      allow delete: if false;

      // Anonymous senders write with no auth at all (that's the
      // feature); only the endpoint's owner can ever read messages back.
      match /messages/{messageId} {
        // Open to anyone (no auth) — except a browser the owner blocked
        // (phase 2: its per-link senderKey is in the endpoint's `blocked`).
        allow create: if !(request.resource.data.get('senderKey', '')
          in get(/databases/$(database)/documents/messageEndpoints/$(endpointId)).data.get('blocked', []));
        allow read: if isEndpointOwner();
        // NGL redesign (2026-10-12): the owner opens sealed messages
        // (`read`) and answers them (`answer`/`answeredAt`) — those three
        // fields only; the message text/game/prompt stay immutable.
        allow update: if isEndpointOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'answer', 'answeredAt'])
          && (!('read' in request.resource.data) || request.resource.data.read is bool)
          && (!('answer' in request.resource.data)
            || request.resource.data.answer == null
            || (request.resource.data.answer is string && request.resource.data.answer.size() <= 500))
          && (!('answeredAt' in request.resource.data)
            || request.resource.data.answeredAt == null
            || request.resource.data.answeredAt == request.time);
        // The owner can delete a message they received (behind a confirm).
        allow delete: if isEndpointOwner();
      }
    }

    // ---- Anonymous two-way reply (phase 2, 2026-10-12) ----
    //
    // threads/{threadId}: the id is a long random capability the SENDER's
    // browser generated and stamped on their message; knowing it is what
    // lets the sender read/post (no sender account exists). Only the link
    // owner can create the thread, and only at the id on that message.
    match /threads/{threadId} {
      function thread() {
        return get(/databases/$(database)/documents/threads/$(threadId)).data;
      }
      function isThreadOwner() {
        return request.auth != null && thread().ownerId == request.auth.uid;
      }
      function senderBlocked() {
        return thread().senderKey != null && thread().senderKey
          in get(/databases/$(database)/documents/messageEndpoints/$(thread().endpointId)).data.get('blocked', []);
      }

      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/messageEndpoints/$(request.resource.data.endpointId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/messageEndpoints/$(request.resource.data.endpointId)/messages/$(request.resource.data.messageId)).data.threadId == threadId
        && request.resource.data.status == 'open';
      // Owner: status (end) + bookkeeping. Sender (anyone with the id):
      // bookkeeping only, while open; marking their side seen always works.
      allow update: if (request.auth != null && resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'ownerUnread', 'senderUnread', 'lastFrom', 'lastActivityAt'])
          && request.resource.data.status in ['open', 'ended'])
        || (resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownerUnread', 'senderUnread', 'lastFrom', 'lastActivityAt'])
          && request.resource.data.lastFrom in [resource.data.lastFrom, 'sender'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senderUnread'])
          && request.resource.data.senderUnread == false);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if thread().status == 'open'
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && ((request.resource.data.from == 'owner' && isThreadOwner())
            || (request.resource.data.from == 'sender' && !senderBlocked()));
        allow update, delete: if false;
      }
    }

    // Sender's "notify me when they reply" push token — write-only for
    // clients (anyone holding the thread id); only Cloud Functions read it.
    match /threadPush/{threadId} {
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 500;
      allow read, delete: if false;
    }

    // #006 push notifications (2026-09-21): fcmTokens lives here, owner-
    // only — a real account is required to receive a push at all (an
    // anonymous room/endpoint visitor has no account/token to attach
    // one to), so pushes only ever reach a room/endpoint's *owner*.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Create-only from any signed-in user; read via the admin dashboard
    // (isUnlockedAdmin) or the Firebase console, never by a regular
    // client.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow list, get: if isUnlockedAdmin();
      allow update, delete: if false;
    }
  }
}
