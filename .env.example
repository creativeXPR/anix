# Firebase client config. Anix shares the "c-xpr25" Firebase project with
# other apps (see CLAUDE.md #008) rather than owning its own project —
# register Anix as its own Web App inside that project (Firebase console >
# c-xpr25 > Project settings > General > Add app) to get its own
# VITE_FIREBASE_APP_ID; the other values (apiKey/authDomain/projectId/
# storageBucket/messagingSenderId) are project-level, shared across apps.
#
# Copy this file to .env and fill in real values. .env is gitignored; this file is not.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate (VAPID) key — Firebase console > c-xpr25 >
# Project settings > Cloud Messaging > Web configuration > generate key
# pair. Required for push notifications (see #006); everything else
# still works without it, enablePush() just no-ops.
VITE_FIREBASE_VAPID_KEY=
