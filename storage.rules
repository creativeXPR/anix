rules_version = '2';

// Same room-scoped model as firestore.rules. anix/ prefix because this
// bucket is shared with other apps under the same Firebase project.
// Banner-upload ownership is enforced at the Firestore layer (only the
// room/endpoint's owner can set `bannerImageUrl` on its doc) — these
// rules just cap size/type, not by who's uploading, to avoid a fragile
// cross-service ownership check against a named (non-default) Firestore
// database from Storage rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /anix/rooms/{roomId}/images/{fileName} {
      allow read: if true;
      // images are compressed to ~1 MB before upload; never overwritten
      allow create: if request.resource.size < 3 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Room stickers (made in the sticker maker): anyone in a room can
    // make one — guests included — so no auth; small images only, never
    // overwritten. Folder = account uid or a per-browser guest key.
    match /anix/stickers/{owner}/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 300 * 1024
                    && request.resource.contentType.matches('image/(webp|png)');
      allow update, delete: if false;
    }

    match /anix/rooms/{roomId}/banner/{fileName} {
      allow read: if true;
      // a real account (the /admin page's anonymous session can't upload)
      allow write: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /anix/endpoints/{endpointId}/banner/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
  }
}
