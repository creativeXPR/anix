{
  "firestore": [
    {
      "database": "anix",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "anix",
    "public": "dist",
    "rewrites": [
      { "source": "/r/**", "function": "linkPreview" },
      { "source": "/m/**", "function": "linkPreview" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
